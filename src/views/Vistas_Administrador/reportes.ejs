<%- include('../cabecera') %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1><i class="fas fa-chart-line text-primary"></i> Reporte de Ventas</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card card-outline card-primary shadow-sm">
                <div class="row mb-3 p-3">
                    <div class="col-12">
                        <button class="btn btn-info" onclick="toggleGrafica()">
                            <i class="fas fa-chart-bar"></i> Ver/Ocultar Gráfica
                        </button>
                    </div>
                </div>

                <div id="contenedorGrafica" class="card mb-4" style="display:none; height: 350px;">
                    <div class="card-body" style="height: 100%;">
                        <canvas id="miGrafica"></canvas>
                    </div>
                </div>

                <div class="card-header">
                    <h3 class="card-title"><i class="fas fa-calendar-alt"></i> Seleccionar Periodo</h3>
                </div>
                <div class="card-body">
                    <form action="/administrador/reportes" method="GET">
                        <div class="row align-items-end">
                            <div class="col-md-4">
                                <label class="font-weight-bold text-muted">Fecha Inicio</label>
                                <input type="date" name="fechaInicio" class="form-control" value="<%= fechaInicio %>" required>
                            </div>
                            <div class="col-md-4">
                                <label class="font-weight-bold text-muted">Fecha Fin</label>
                                <input type="date" name="fechaFin" class="form-control" value="<%= fechaFin %>" required>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-block">
                                    <i class="fas fa-search"></i> Filtrar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h3 class="card-title"><i class="fas fa-table"></i> Resultados de Ventas</h3>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="bg-primary text-white">
                            <tr>
                                <th><i class="fas fa-calendar-day"></i> Fecha</th>
                                <th><i class="fas fa-dollar-sign"></i> Total Ventas</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% reporte.forEach(r => { %>
                                <tr>
                                    <td class="align-middle"><%= new Date(r.dia).toISOString().split('T')[0] %></td>
                                    <td class="align-middle font-weight-bold text-success">
                                        <%= r.total_ventas %> venta(s)
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

<%- include('../pie') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    $(document).ready(function() {
        <% if (locals.alertAlert) { %>
            Swal.fire({ icon: 'success', title: '¡Operación Exitosa!', text: '<%= alertAlert %>', timer: 3500 });
        <% } %>
        <% if (locals.errorMessage) { %>
            Swal.fire({ icon: 'error', title: 'Oops...', text: '<%= errorMessage %>' });
        <% } %>
    });

    function toggleGrafica() {
        const div = document.getElementById('contenedorGrafica');
        div.style.display = (div.style.display === 'none') ? 'block' : 'none';
        if (div.style.display === 'block') window.dispatchEvent(new Event('resize'));
    }

    // Inicialización de la gráfica
    document.addEventListener("DOMContentLoaded", function() {
        const datosReporte = <%- JSON.stringify(reporte) %>;
        const etiquetas = datosReporte.map(r => new Date(r.dia).toISOString().split('T')[0]);
        const totales = datosReporte.map(r => r.total_ventas);

        const ctx = document.getElementById('miGrafica').getContext('2d');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: etiquetas,
                datasets: [{
                    label: 'Cantidad de Ventas',
                    data: totales,
                    backgroundColor: 'rgba(52, 144, 220, 0.6)',
                    borderColor: 'rgba(52, 144, 220, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { y: { beginAtZero: true } }
            }
        });
    });
</script>
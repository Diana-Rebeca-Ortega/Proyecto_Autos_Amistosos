<%- include('../cabecera') %>

<section class="content">
    <div class="container-fluid">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Editar Cliente: <%= cliente.Nombre %></h3>
            </div>
            <form action="/vendedor/clientes/editar/<%= cliente.idCliente %>" method="POST">
                <div class="card-body">
                    <div class="form-group">
                        <label>Nombre</label>
                        <input type="text" name="Nombre" class="form-control" value="<%= cliente.Nombre %>" required>
                    </div>
                    <div class="form-group">
                        <label>Apellido Paterno</label>
                        <input type="text" name="Apellido1" class="form-control" value="<%= cliente.Apellido1 %>" required>
                    </div>
                    <div class="form-group">
                        <label>Apellido Materno</label>
                        <input type="text" name="Apellido2" class="form-control" value="<%= cliente.Apellido2 %>">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="Email" class="form-control" value="<%= cliente.Email %>" required>
                    </div>
                </div>
                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                    <a href="/vendedor/clientes" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</section>

<%- include('../pie') %>
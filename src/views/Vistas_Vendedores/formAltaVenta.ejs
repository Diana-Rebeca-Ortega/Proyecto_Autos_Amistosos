<div id="app-modal" class="modal fade" id="modalAltaVenta" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form @submit.prevent="registrarVenta">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Cliente</label>
                            <select v-model="venta.clienteId" class="form-control" required>
                                <option value="">Seleccione un cliente...</option>
                                <option v-for="c in clientes" :value="c.idCliente">{{ c.Nombre }}</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6 form-group">
                            <label>Automóvil</label>
                            <select v-model="venta.autoId" class="form-control" required>
                                <option value="">Seleccione un automóvil...</option>
                                <option v-for="a in autos" :value="a.idAutomovil">{{ a.Modelo }} ({{ a.idAutomovil }})</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Precio Final</label>
                            <input type="number" v-model="venta.precio" class="form-control" required>
                        </div>
                        </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
const { createApp } = Vue;

createApp({
    data() {
        return {
            clientes: <%- JSON.stringify(clientes) %>,
            autos: <%- JSON.stringify(autos) %>,
            venta: {
                clienteId: '',
                autoId: '',
                precio: 0,
                impuesto: 0
            }
        }
    },
    methods: {
        async registrarVenta() {
            try {
                const response = await fetch('/vendedor/ventas/crear', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(this.venta)
                });
                
                const data = await response.json();
                if (data.success) {
                    $('#modalAltaVenta').modal('hide'); // Cierra el modal de Bootstrap
                    Swal.fire('¡Éxito!', 'Venta registrada', 'success');
                }
            } catch (error) {
                Swal.fire('Error', 'No se pudo guardar la venta', 'error');
            }
        }
    }
}).mount('#app-modal');
</script>
<div class="modal fade" id="modalAltaVenta" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="exampleModalLabel">Registrar Nueva Venta</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            
            <form action="/vendedor/ventas/crear" method="POST">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Cliente</label>
                            <select name="cliente_id" class="form-control" required>
                                <option value="">Seleccione un cliente...</option>
                                <% clientes.forEach(c => { %>
                                    <option value="<%= c.idCliente %>"><%= c.Nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-md-6 form-group">
                            <label>Automóvil (VIN)</label>
                            <input type="text" name="idAutomovil" class="form-control" placeholder="Ej: 1A2B3C4D5E6F7G8H9" maxlength="17" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label>Precio Final</label>
                            <input type="number" step="0.01" name="precio_final" class="form-control" placeholder="0.00" required>
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Impuesto Venta</label>
                            <input type="number" step="0.01" name="impuesto_venta" class="form-control" value="0.00">
                        </div>
                        <div class="col-md-4 form-group">
                            <label>Costo Licencia</label>
                            <input type="number" step="0.01" name="costo_licencia" class="form-control" value="0.00">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group">
                            <label>Fecha de Venta</label>
                            <input type="date" name="fecha_venta" class="form-control" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Venta</button>
                </div>
            </form>
        </div>
    </div>
</div>
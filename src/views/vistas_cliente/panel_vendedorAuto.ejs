<button onclick="document.getElementById('modalCarros').style.display='block'">Ver Inventario</button>

<div id="modalCarros" style="display:none; position:fixed; z-index:1; left:0; top:0; width:100%; height:100%; background:rgba(0,0,0,0.5);">
    <div style="background:white; margin:10% auto; padding:20px; width:80%; max-height:70%; overflow-y:auto;">
        <span onclick="document.getElementById('modalCarros').style.display='none'" style="float:right; cursor:pointer;">&times; Cerrar</span>
        <h2>Automóviles Disponibles</h2>
        
        <table border="1" width="100%">
            <tr>
                <th>Modelo</th><th>Precio</th><th>Color</th><th>Condición</th>
            </tr>
            <% listaCarros.forEach(function(carro) { %>
            <tr>
                <td><%= carro.Modelo %></td>
                <td>$<%= carro.Precio_Lista %></td>
                <td><%= carro.Color %></td>
                <td><%= carro.Condicion %></td>
            </tr>
            <% }); %>
        </table>
    </div>
</div>
<%- include('../cabecera') %>

<section class="content-header">
    <h1>Mis Autos Favoritos</h1>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <% if (listaFavoritos.length > 0) { %>
                <% listaFavoritos.forEach(auto => { %>
                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card card-danger card-outline">
                            <div class="card-body text-center">
                                <i class="fas fa-heart fa-3x text-danger mb-3"></i>
                                <h5><%= auto.Modelo %></h5>
                                <p>Precio: $<%= auto.Precio_Lista %></p>
                                <a href="/cliente/detalle/<%= auto.idAutomovil %>" class="btn btn-outline-primary btn-block">Ver Detalles</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p>No tienes autos en favoritos aún.</p>
                    <a href="/cliente/explorar_autos" class="btn btn-primary">Ir a explorar autos</a>
                </div>
            <% } %>
        </div>
    </div>
</section>

<%- include('../pie') %>
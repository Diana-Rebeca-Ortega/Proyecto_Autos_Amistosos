<%- include('../cabecera') %>

<section class="content">
    <div class="card card-primary card-outline p-4">
        <div class="row">
            <div class="col-md-6 text-center">
                <i class="fas fa-car fa-10x text-primary"></i>
            </div>
            <div class="col-md-6">
                <h1><%= auto.Modelo %></h1>
                <p><strong>Precio:</strong> $<%= auto.Precio_Lista %></p>
                <p><strong>Color:</strong> <%= auto.Color %></p>
                <p><strong>Condición:</strong> <%= auto.Condicion %></p>
                <p><strong>Tipo:</strong> <%= auto.Tipo_Carroceria %></p>
                <p><strong>Kilometraje:</strong> <%= auto.Kilometraje_Entrega %> km</p>
                
                <hr>
                
<i id="iconoFavorito"  <%= esFavorito ? 'text-danger' : 'text-primary' %>"></i>

<form id="formFavoritos">
    <input type="hidden" name="idAutomovil" value="<%= auto.idAutomovil %>">
    <button type="button" onclick="toggleFavorito()" class="btn btn-outline-danger btn-lg">
        <i class="fas fa-heart"></i> 
        <span id="textoBoton"><%= esFavorito ? 'Eliminar de Favoritos' : 'Añadir a Favoritos' %></span>
    </button>
</form>


                <a href="/cliente/explorar_autos" class="btn btn-secondary btn-lg">Volver</a>
            </div>
        </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    async function toggleFavorito() {
    const form = document.getElementById('formFavoritos');
    const formData = new FormData(form);
    
    const response = await fetch('/cliente/favoritos/accion', {
        method: 'POST',
        body: new URLSearchParams(formData)
    });
    
    const data = await response.json();
    const icono = document.getElementById('iconoFavorito');
    const texto = document.getElementById('textoBoton');

    if (data.success) {
        if (data.accion === 'agregado') {
            icono.classList.remove('text-primary');
            icono.classList.add('text-danger');
            texto.innerText = 'Eliminar de Favoritos';
        } else {
            icono.classList.remove('text-danger');
            icono.classList.add('text-primary');
            texto.innerText = 'Añadir a Favoritos';
        }
    }
}
    async function agregarFavorito() {
        const form = document.getElementById('formFavoritos');
        const formData = new FormData(form);
        
        const response = await fetch('/cliente/favoritos/accion', {
            method: 'POST',
            body: new URLSearchParams(formData)
        });
        
        const data = await response.json();

        if (data.success) {
            Swal.fire({
                icon: 'success',
                title: '¡Excelente!',
                text: data.message,
                confirmButtonColor: '#3085d6'
            });
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: data.message
            });
        }
    }
</script>
<%- include('../pie') %>
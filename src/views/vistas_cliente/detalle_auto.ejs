<%- include('../cabecera') %>

<section id="app" class="content">
    <div class="card card-primary card-outline p-4">
        <div class="row">
            <div class="col-md-6 text-center">
                <i class="fas fa-car fa-10x" :class="esFavorito ? 'text-danger' : 'text-primary'"></i>
            </div>
            <div class="col-md-6">
                <h1><%= auto.Modelo %></h1>
                <p><strong>Precio:</strong> $<%= auto.Precio_Lista %></p>
                <hr>
                
                <button type="button" @click="toggleFavorito" class="btn btn-outline-danger btn-lg">
                    <i class="fas fa-heart"></i> 
                    {{ esFavorito ? 'Eliminar de Favoritos' : 'Añadir a Favoritos' }}
                </button>

                <a href="/cliente/explorar_autos" class="btn btn-secondary btn-lg">Volver</a>
            </div>
        </div>
    </div>
</section>

<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                // Pasamos el valor inicial que viene del servidor (EJS) a Vue
                esFavorito: <%= esFavorito %>, 
                idAutomovil: '<%= auto.idAutomovil %>'
            }
        },
        methods: {
            async toggleFavorito() {
                // Preparamos los datos
                const formData = new URLSearchParams();
                formData.append('idAutomovil', this.idAutomovil);

                const response = await fetch('/cliente/favoritos/accion', {
                    method: 'POST',
                    body: formData
                });
                
                const data = await response.json();

                if (data.success) {
                    // La magia de Vue: solo cambiamos el estado, el HTML se actualiza solo
                    this.esFavorito = !this.esFavorito;
                    
                    Swal.fire({
                        icon: 'success',
                        title: this.esFavorito ? '¡Añadido!' : '¡Eliminado!',
                        timer: 1500,
                        showConfirmButton: false
                    });
                }
            }
        }
    }).mount('#app');
</script>


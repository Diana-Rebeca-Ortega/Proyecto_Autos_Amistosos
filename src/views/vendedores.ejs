<!DOCTYPE html>
<html>
<head>
    <title>Lista de Vendedores</title>
    <link rel="stylesheet" href="/css/stilos.css">
<body>
    <h1>Panel de Vendedores - Autos Amistosos</h1>
    <div class="container mt-5"> <h1 class="text-white mb-4">Lista de Vendedores</h1> <table class="table table-dark table-hover table-striped"> 
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Salario</th>
            </tr>
        </thead>
        <tbody>
            <% vendedores.forEach(v => { %>
                <tr>
                    <td><%= v.idVendedor %></td>
                    <td><%= v.Nombre %></td>
                    <td><%= v.Apellido1 %></td>
                    <td>$<%= v.Salario_Base %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
</body>
</html>